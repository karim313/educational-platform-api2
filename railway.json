{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm ci"
    },
    "deploy": {
        "startCommand": "npx ts-node src/server.ts",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 60,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    },
    "environments": {
        "production": {
            "variables": {
                "NODE_ENV": "production"
            }
        }
    }
}